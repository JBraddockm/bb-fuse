<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-link</artifactId>
    <name>bb-link</name>
    <description>
        Daemon that manages BlackBerry 10 devices through the BlackBerry Link protocol and serves
        line-delimited JSON.
    </description>

    <properties>
        <main.class>com.jbraddockm.link.Launcher</main.class>
        <native.image.name>bb-link</native.image.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jbraddockm</groupId>
            <artifactId>bb-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- mDNS/DNS-SD backs bb-core's core.mdns (the shared facility bb-link advertises the bp2p
             _friendly service over). core.mdns declares it optional, so bb-link declares it here for
             its own runtime and native image. -->
        <dependency>
            <groupId>org.jmdns</groupId>
            <artifactId>jmdns</artifactId>
            <version>3.6.1</version>
        </dependency>

        <!-- The in-process SMB1 client for the device file share (transport.smb). The device's Samba
             speaks SMB1/CIFS only, so the SMB1 path of this library is used; it keeps SMB1 contained
             to the daemon rather than requiring the host OS to enable its own SMB1 client. -->
        <dependency>
            <groupId>org.codelibs</groupId>
            <artifactId>jcifs</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- Original BlackBerry tooling (version managed by the parent). BarDeploy now provides only
             the login challenge hashing (com.qnx.bbt.deploy.PwCrypto) and the failure-message strings
             (Messages) that the login path still uses. Its device detector — the sole user of the
             Apache HTTP stack — has been retired (the CGI transport is on java.net.http, discovery on
             bb-core's native scanners), so that whole stack is gone. -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarDeploy</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- A device presents a certificate for an address it does not name, so the
                         device transport turns off java.net.http's host check (there is no per-client
                         switch); the TLS device test needs the same at the JVM that runs it. -->
                    <argLine>@{argLine} -Djdk.internal.httpclient.disableHostnameVerification=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>

                <configuration>
                    <buildArgs combine.children="append">

                        <!--
                            The device scan calls into the original tool, whose Deploy class builds
                            its TLS context when it is initialised. That must happen at run time.
                        -->
                        <buildArg>
                            --initialize-at-run-time=com.qnx.bbt.deploy.Deploy
                        </buildArg>

                        <!-- Login failure texts and the scan come from the original tool's bundle. -->
                        <buildArg>
                            -H:IncludeResourceBundles=com.qnx.bbt.deploy.messages
                        </buildArg>
                        <buildArg>
                            -H:IncludeResourceBundles=com.sun.org.apache.xerces.internal.impl.msg.XMLMessages
                        </buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
