<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-core</artifactId>
    <name>bb-core</name>
    <description>
        Shared runtime for the BlackBerry 10 daemons: JSON, error vocabulary, the line-delimited
        JSON protocol server, BAR inspection, device discovery (USB and mDNS), the shared mDNS
        advertise/browse facility, and the tunnel-broker client.
    </description>

    <dependencies>
        <!-- mDNS/DNS-SD for core.mdns (the shared advertise/browse facility). Optional so it does not
             leak onto the classpath of consumers that do not use mDNS (e.g. bb-tunnel); modules that
             use core.mdns (bb-link) declare it themselves. -->
        <dependency>
            <groupId>org.jmdns</groupId>
            <artifactId>jmdns</artifactId>
            <version>3.6.1</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jmdns (core.mdns) logs through SLF4J. With no provider on the classpath, SLF4J prints a
             "No SLF4J providers were found" warning the first time a logger is created. A no-op
             provider in test scope binds quietly so the test output stays clean. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- A library has no main class; drop the manifest the parent configures. -->
                    <archive combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
