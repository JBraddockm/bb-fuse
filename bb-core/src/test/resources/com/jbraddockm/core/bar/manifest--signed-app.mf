Invoke-Target-Type: card.previewer
Invoke-Target-Filter: actions=bb.action.SHARE;types=text/plain;
Invoke-Target-Filter: actions=bb.action.SHARE;types=message/rfc822;uris=pim:;
Invoke-Target-Filter: actions=bb.action.VIEW,bb.action.SHARE,bb.action.OPEN;types=*;uris=file://,list://;exts=text,log,enc1,csv,jpg,png,gif,bmp,tif,mp3,wav,ogg,m4a,wma,amr,aac,avi,mp4,mkv,3gp,flv,mov,vcs,swf,psd,eps,apk,com,exe,jar,rom,dwg,dxf,txt,doc,rtf,pdf,xls,vcf,vcs,crypt,dat,rar,
 zip,gz,tgz,cbr,pkg,sitx,bin,dmg,msi,,iso,html,htm,asp,fon,fnt,ttf,cab,ddl,ico,sys,xml,pps,ppt,pptx;

