Invoke-Target-Key: com.example.PowerTools3
Invoke-Target-Label: Power_Tools Service
Invoke-Target-Entry-Point-Ref: Power_ToolsService
Invoke-Target-Type: application.headless
Invoke-Target-Filter: actions=bb.action.system.STARTED;types=application/vnd.blackberry.system.event.STARTED;uris=data://local;
Invoke-Target-Filter: actions=com.example.Power_ToolsService.RESET;types=*;uris=headless:;

Invoke-Target-Key: com.example.Power_Tools
Invoke-Target-Label: Power_Tools
Invoke-Target-Icon: {114x114}native/icon.png
Invoke-Target-Entry-Point-Ref: Power_Tools
Invoke-Target-Type: application
Invoke-Target-Filter: actions=bb.action.VIEW;types=*;uris=file://;exts=pt1;

Invoke-Target-Key: com.powertools.invocation.previewer3
