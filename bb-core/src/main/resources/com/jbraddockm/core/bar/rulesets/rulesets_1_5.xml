<?xml version="1.0" encoding="UTF-8"?>

<!-- @SpecificationDependent -->

<rules barSpecificationVersion="1.5">

    <barName regexId="barName_1_3" />

    <userDefinedAttributesAllowed>false</userDefinedAttributesAllowed>

    <rulesSets>
    
        <!--                      -->
        <!-- application rule set -->
        <!--                      -->
    
        <rulesSet packageType="application">
            <sections>
                <section name="Archive" required="true">
                    <attributes>
                        <attribute name="Archive-Manifest-Version" required="true" regexId="version_short" />
                        <attribute name="Archive-Created-By" regexId="createdBy" cardinality="0..1" continuationAllowed="false" />
                    </attributes>
                </section>
                <section name="Package" required="true">
                    <attributes>
                        <attribute name="Package-Type" required="true" regexId="package_type_application" />
                        <attribute name="Package-Name" required="true" regexId="reverse_dns" maxLength="50" continuationAllowed="false" />
                        <attribute name="Package-Description" regexId="value_255" canLocalize="true" />
                        <attribute name="Package-Id" required="if-signed" regexId="id" />
                        <attribute name="Package-Author" required="true" regexId="value_50" continuationAllowed="false" />
                        <attribute name="Package-Author-Id" required="if-signed" regexId="id" />
                        <attribute name="Package-Author-Certificate-Hash" required="if-signed" regexId="base64_255" />
                        <attribute name="Package-Version" required="true" regexId="version" />
                        <attribute name="Package-Version-Id" required="if-signed" regexId="id" />
                        <attribute name="Package-Architecture" regexId="value_255" />
                        <attribute name="Package-Locale" regexId="locale" maxLength="512" />
                        <attribute name="Package-Issue-Date" regexId="date_iso_8601" required="if-signed" />
                    </attributes>                
                </section>
                <section name="Application" required="true">
                    <attributes>
                        <attribute name="Application-Name" required="true" regexId="value_50" continuationAllowed="false" canLocalize="true" />
                        <attribute name="Application-Description" regexId="value_255" cardinality="0..1" canLocalize="true" />
                        <attribute name="Application-Id" required="if-signed" regexId="id" cardinality="0..1" />
                        <attribute name="Application-Version" required="true" regexId="version" />
                        <attribute name="Application-Version-Id" required="if-signed" regexId="id" cardinality="0..1" />
                        <attribute name="Application-Category" regexId="value_50" cardinality="0..1" canLocalize="true" />
                        <attribute name="Application-Development-Mode" regexId="boolean" cardinality="0..1" />
                        <attribute name="Application-Requires-System" regexId="requires_version" cardinality="0..1" />
                    </attributes>                
                </section>
                <section name="Entry-Point" required="false" cardinality="0..*">
                    <attributes>
                        <attribute name="Entry-Point-Name" required="true" mandatoryFirstInSection="true" regexId="value_50" continuationAllowed="false" canLocalize="true" />
                        <attribute name="Entry-Point-Localization" regexId="value_50" canLocalize="true" />
                        <attribute name="Entry-Point-Type" required="true" regexId="entry_point_type" maxLength="255" />
                        <attribute name="Entry-Point" required="true" regexId="value_4096" />
                        <attribute name="Entry-Point-Icon" regexId="value_4096" cardinality="0..1" canLocalize="true" />
                        <attribute name="Entry-Point-Icon-Focus" regexId="value_4096" cardinality="0..1" canLocalize="true" />
                        <attribute name="Entry-Point-Orientation" regexId="orientation" cardinality="0..1" />
                        <attribute name="Entry-Point-Splash-Screen" regexId="value_4096" cardinality="0..1" canLocalize="true" />
                        <attribute name="Entry-Point-User-Actions" regexId="entry_point_actions" cardinality="0..1" />
                        <attribute name="Entry-Point-System-Actions" regexId="entry_point_actions" cardinality="0..1" />
                        <attribute name="Entry-Point-Key" required="true" regexId="key25" continuationAllowed="false" canLocalize="true" />
                    </attributes>
                </section>
                <section name="Archive-Asset" required="false" cardinality="0..*">
                    <attributes>
                        <attribute name="Archive-Asset-Name" required="true" regexId="value_255" />
                        <attribute name="Archive-Asset-x-Digest" required="if-signed" regexId="base64_255" cardinality="0..*" />
                        <attribute name="Archive-Asset-Type" regexId="mime_type" maxLength="255" />
                    </attributes>                
                </section>
                <section name="Invoke-Target" required="false" cardinality="0..*">
                    <attributes>
                        <attribute name="Invoke-Target-Entry-Point-Ref" required="if-section" regexId="key25" continuationAllowed="false" />
                        <attribute name="Invoke-Target-Key" required="if-section" regexId="reverse_dns" maxLength="50" continuationAllowed="false" canLocalize="true" />
                        <!-- [MKS 6009896] attribute name="Invoke-Target-Require-Capabilities" regexId="entry_point_actions" /> -->
                        <attribute name="Invoke-Target-Type" required="if-section" regexId="target_type" />
                        <!-- Invoke-Target-Filter requires more complex validation (performed in Attribute.java) -->
                        <attribute name="Invoke-Target-Filter" maxLength="4096" cardinality="1..*" />
                        <attribute name="Invoke-Target-Label" regexId="value_50" continuationAllowed="false" canLocalize="true" />
                        <attribute name="Invoke-Target-Icon" regexId="value_4096" canLocalize="true" />
                        <attribute name="Invoke-Target-Splash-Screen" regexId="value_4096" canLocalize="true" />
                    </attributes>              
                </section>
            </sections>
        </rulesSet>
        
