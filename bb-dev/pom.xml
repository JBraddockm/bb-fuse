<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-dev</artifactId>
    <name>bb-dev</name>
    <description>
        The developer tools for BlackBerry 10 devices — connect, deploy and package — as one native
        executable with a namespace per tool. Pure JDK; the successor to bb-connect, bb-deploy and
        bb-packager.
    </description>

    <properties>
        <main.class>com.jbraddockm.dev.Launcher</main.class>
        <native.image.name>bb-dev</native.image.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jbraddockm</groupId>
            <artifactId>bb-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
